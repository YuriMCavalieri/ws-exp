{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WS Plataforma — contrato de mensagens v1",
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "pattern": "^ws:"
        },
        "v": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "imovel": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "endereco": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "area": {
          "type": "number"
        },
        "quartos": {
          "type": "integer"
        },
        "suites": {
          "type": "integer"
        },
        "vagas": {
          "type": "integer"
        },
        "andar": {
          "type": "integer"
        },
        "preco": {
          "type": "number"
        },
        "wsi": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string"
        }
      }
    },
    "lead": {
      "type": "object",
      "required": [
        "nome",
        "telefone",
        "quando"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "minLength": 2
        },
        "telefone": {
          "type": "string",
          "minLength": 8
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "intencao": {
          "type": "string"
        },
        "projeto": {
          "type": "string"
        },
        "wsi": {
          "type": [
            "number",
            "null"
          ]
        },
        "area": {
          "type": "number"
        },
        "comodos": {
          "type": "integer"
        },
        "tempo_no_tour_s": {
          "type": "number",
          "minimum": 0
        },
        "atencao": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "carrinho": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "preco"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "preco": {
                "type": "number"
              }
            }
          }
        },
        "valor_carrinho": {
          "type": "number"
        },
        "quando": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "sku",
        "nome"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "nome": {
          "type": "string"
        },
        "categoria": {
          "type": "string"
        },
        "preco": {
          "type": "number"
        },
        "dimensoes": {
          "type": "object",
          "properties": {
            "largura": {
              "type": "number"
            },
            "altura": {
              "type": "number"
            },
            "profundidade": {
              "type": "number"
            }
          }
        },
        "loja": {
          "type": "string"
        },
        "licenca": {
          "type": "string"
        },
        "glb": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "midia": {
      "type": "object",
      "properties": {
        "splat": {
          "type": "string"
        },
        "colisor": {
          "type": "string"
        },
        "panoramas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fotos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambientes": {
          "type": "array",
          "description": "Um item por comodo navegavel. Quando presente, tem precedencia sobre 'splat'/'colisor', que sao o atalho de ambiente unico.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "splat"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "splat": {
                "type": "string",
                "description": ".rad paginado, .splat ou .ply"
              },
              "colisor": {
                "type": "string",
                "description": "GLB invisivel; sem ele a medicao fica desligada"
              },
              "capa": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              },
              "gerado": {
                "type": "boolean",
                "description": "true = ambiente gerado por IA, nunca imovel real a venda"
              },
              "cal": {
                "type": "object",
                "properties": {
                  "rotY": {
                    "type": "number"
                  },
                  "escala": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "walkthroughModelo": {
      "type": "object",
      "description": "Autoria do tour: como os comodos se ligam, onde estao os pinos de movel e a calibracao acertada de cada ambiente. Formato achatado de proposito — cada passagem carrega o ambiente de origem, para virar linha de tabela.",
      "properties": {
        "v": {
          "type": "integer",
          "minimum": 1
        },
        "ambientes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "gerado": {
                "type": "boolean"
              },
              "crop": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cal": {
                "type": "object"
              }
            }
          }
        },
        "passagens": {
          "type": "array",
          "description": "Arestas do grafo de comodos. 'para' nulo = passagem criada e ainda sem destino.",
          "items": {
            "type": "object",
            "required": [
              "de",
              "x",
              "y",
              "z"
            ],
            "properties": {
              "de": {
                "type": "string"
              },
              "para": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          }
        },
        "pinos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ambiente",
              "x",
              "y",
              "z"
            ],
            "properties": {
              "ambiente": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "movel": {
                "$ref": "#/$defs/item"
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "ws:pronto",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:pronto"
        },
        "camada": {
          "enum": [
            "mundo",
            "studio",
            "atelier",
            "tour",
            "walkthrough"
          ]
        }
      },
      "required": [
        "camada"
      ]
    },
    {
      "title": "ws:lead",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:lead"
        },
        "lead": {
          "$ref": "#/$defs/lead"
        }
      },
      "required": [
        "lead"
      ]
    },
    {
      "title": "ws:space-model",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:space-model"
        },
        "space": {
          "type": "object"
        },
        "imovelId": {
          "type": "string"
        },
        "abrirImovel": {
          "type": "string"
        }
      },
      "required": [
        "space"
      ]
    },
    {
      "title": "ws:entrar-imovel",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:entrar-imovel"
        },
        "imovel": {
          "$ref": "#/$defs/imovel"
        },
        "space": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "imovel"
      ]
    },
    {
      "title": "ws:entrar-walkthrough",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:entrar-walkthrough"
        },
        "imovel": {
          "$ref": "#/$defs/imovel"
        }
      },
      "required": [
        "imovel"
      ]
    },
    {
      "title": "ws:carrinho",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:carrinho"
        },
        "itens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "required": [
        "itens"
      ]
    },
    {
      "title": "ws:atelier-movel",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:atelier-movel"
        },
        "item": {
          "$ref": "#/$defs/item"
        }
      },
      "required": [
        "item"
      ]
    },
    {
      "title": "ws:atelier-pino",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:atelier-pino"
        },
        "item": {
          "$ref": "#/$defs/item"
        }
      },
      "required": [
        "item"
      ]
    },
    {
      "title": "navegacao",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "enum": [
            "ws:voltar-mundo",
            "ws:ir-para-mundo",
            "ws:ir-para-studio",
            "ws:abrir-atelier",
            "ws:camada-real"
          ]
        }
      }
    },
    {
      "title": "ws:walkthrough-modelo",
      "description": "camada -> app. Autoria do tour mudou. PERSISTIR: tabela walkthrough_modelos.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:walkthrough-modelo"
        },
        "camada": {
          "const": "walkthrough"
        },
        "imovelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelo": {
          "$ref": "#/$defs/walkthroughModelo"
        }
      },
      "required": [
        "modelo"
      ]
    },
    {
      "title": "ws:walkthrough-sessao",
      "description": "camada -> app. Onde o visitante parou e quanto tempo de atencao ATIVA deu a cada comodo. Emitido a cada ~15 s, ao mudar o carrinho e ao sair da pagina. PERSISTIR: tabela walkthrough_sessoes. Os segundos ja descontam aba oculta e ociosidade acima de 45 s — sao comparaveis entre imoveis.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:walkthrough-sessao"
        },
        "camada": {
          "const": "walkthrough"
        },
        "imovelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "ambienteId": {
          "type": [
            "string",
            "null"
          ],
          "description": "comodo em que estava ao emitir"
        },
        "camera": {
          "type": "object",
          "description": "posicao e orientacao para retomar a visita onde parou",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "yaw": {
              "type": "number"
            },
            "pitch": {
              "type": "number"
            },
            "orbita": {
              "type": "boolean"
            }
          }
        },
        "atencao": {
          "type": "object",
          "description": "segundos de atencao ativa por NOME de comodo — { \"Sala\": 88 }",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "atencaoPorId": {
          "type": "object",
          "description": "o mesmo, chaveado pelo id do ambiente — estavel a renomeacao",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "tempoTotalS": {
          "type": "integer",
          "minimum": 0
        },
        "carrinho": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "required": [
        "atencao",
        "tempoTotalS"
      ]
    },
    {
      "title": "ws:carregar-imovel",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:carregar-imovel"
        },
        "imovel": {
          "$ref": "#/$defs/imovel"
        },
        "space": {
          "type": [
            "object",
            "null"
          ]
        },
        "midia": {
          "$ref": "#/$defs/midia"
        },
        "walkthrough": {
          "$ref": "#/$defs/walkthroughModelo",
          "description": "Modelo autoral gravado numa sessao anterior. Restaura passagens, pinos e calibracao."
        }
      },
      "required": [
        "imovel"
      ]
    },
    {
      "title": "ws:pedir-space",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:pedir-space"
        },
        "imovelId": {
          "type": "string"
        }
      }
    },
    {
      "title": "ws:ir-para",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:ir-para"
        },
        "alvo": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "altitude": {
              "type": "number"
            },
            "ambiente": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "alvo"
      ]
    },
    {
      "title": "ws:pedir-walkthrough",
      "description": "app -> camada. Pede o modelo autoral atual; a camada responde com ws:walkthrough-modelo.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:pedir-walkthrough"
        },
        "imovelId": {
          "type": "string"
        }
      }
    },
    {
      "title": "ws:pedido-mundo",
      "description": "camada -> app. Pedido de geracao de ambiente quando nao ha endpoint ligado. NUNCA carrega as fotos: elas ficam no navegador e sobem pela Edge Function.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:pedido-mundo"
        },
        "camada": {
          "const": "walkthrough"
        },
        "pedido": {
          "type": "object",
          "properties": {
            "nome": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "quantidadeImagens": {
              "type": "integer"
            },
            "custoEstimadoCreditos": {
              "type": "integer"
            },
            "imagens": {
              "type": "array",
              "description": "So metadado: nome do arquivo e tamanho. Sem conteudo de imagem.",
              "items": {
                "type": "object",
                "properties": {
                  "arquivo": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer"
                  }
                },
                "not": {
                  "required": [
                    "dado"
                  ]
                }
              }
            }
          }
        }
      },
      "required": [
        "pedido"
      ]
    },
    {
      "title": "ws:pedir-sessao",
      "description": "app -> camada. Feche o trecho em curso e emita ws:walkthrough-sessao agora. Use antes de desmontar o iframe: sem isso perdem-se ate 15 s de atencao medida.",
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "properties": {
        "tipo": {
          "const": "ws:pedir-sessao"
        }
      }
    }
  ]
}